# Copie para contrib/alfred/alfred.env e ajuste — o servidor lê esse arquivo sozinho:
#   node contrib/alfred/server.mjs

# Cérebro: auto (padrão) usa o OmniRoute se ele responder, senão a IA do PC (Ollama) se ela
# responder, senão o Gemini (se houver chave), senão o Groq (se houver chave), senão a OpenAI (se
# houver chave), senão o Claude Code instalado neste PC.
# Force com: omniroute | local | gemini | groq | openai | claude
# (o instalador do Windows pergunta e grava aqui)
ALFRED_BRAIN=auto
# IA do PC, GRÁTIS e sem chave: um modelo aberto rodando no Ollama (https://ollama.com).
# Baixe o modelo uma vez com:  ollama pull gemma3:4b   (ou gemma3:1b em PC com pouca memória)
# ALFRED_LOCAL_MODEL=gemma3:4b
# ALFRED_LOCAL_URL=http://localhost:11434/v1
# Gemini do Google, GRÁTIS (não gasta o seu plano do Claude): crie a chave em
# https://aistudio.google.com/apikey e cole aqui. No plano grátis ele não pesquisa na internet.
GEMINI_API_KEY=
# ALFRED_GEMINI_MODEL=gemini-flash-latest
# Groq, GRÁTIS e muito rápido (cérebro reserva): crie a chave em https://console.groq.com/keys
# (só com e-mail, sem cartão). No plano grátis ele não pesquisa na internet.
GROQ_API_KEY=
# ALFRED_GROQ_MODEL=openai/gpt-oss-120b
# Reserva: se o cérebro falhar antes de responder (limite do plano, internet caiu…), o Alfred
# responde com o Gemini e depois o Groq, se houver chave. off = sem reserva.
# ALFRED_RESERVA=on
# Claude Code: o Claude do seu plano Pro/Max divide o limite com as suas conversas no Claude.
# Por isso o Alfred usa o modelo leve (haiku) no dia a dia e o mais forte (sonnet) quando a
# pergunta pede explicação, texto ou plano. Para usar sempre um só: sonnet, opus ou haiku.
# ALFRED_CLAUDE_MODEL=auto
# Quanto o Claude pensa antes de responder: low (padrão, mais rápido), medium, high
# ALFRED_CLAUDE_EFFORT=low
# Modelo da OpenAI quando o cérebro é openai
# ALFRED_OPENAI_MODEL=gpt-4o-mini

# Internet: full = pesquisar e ler páginas (padrão), search = só pesquisar, off = sem internet.
# Claude: usa as ferramentas WebSearch/WebFetch do Claude Code (só leitura da web).
# OpenAI: usa o modelo de pesquisa abaixo (pesquisa a cada pergunta; custa um pouco mais).
# OmniRoute: use um modelo que pesquisa sozinho, ex.: ALFRED_MODEL=perplexity/sonar
ALFRED_WEB=full
# IA do PC, Gemini e Groq: o próprio Alfred busca dólar, clima, notícias e "quem é" (grátis, sem
# chave). Cidade do clima quando a pergunta não diz qual; é também a cidade dos alertas do INMET
# (tempestade, ventania…) e, em Rondônia, das notícias da região:
# ALFRED_CITY=São Paulo
# ALFRED_OPENAI_SEARCH_MODEL=gpt-5-search-api

# Endpoint OpenAI-compatível do OmniRoute
OMNIROUTE_URL=http://localhost:20128/v1
# Chave de API criada no dashboard do OmniRoute (obrigatória se REQUIRE_API_KEY=true)
OMNIROUTE_API_KEY=
# Modelo ou combo: auto, auto/fast, auto/smart, ou qualquer modelo/combo do seu OmniRoute
ALFRED_MODEL=auto

# Onde o Alfred escuta. Use 0.0.0.0 só com ALFRED_TOKEN definido.
ALFRED_HOST=127.0.0.1
ALFRED_PORT=20140
# Senha das rotas /api/* para o celular e outros aparelhos (a página aberta no próprio notebook não
# precisa). O windows\celular.ps1 cria a senha, o endereço e o canal dos avisos sozinho.
ALFRED_TOKEN=
# Outros nomes pelos quais este Alfred atende (o endereço do Tailscale já é aceito sozinho)
# ALFRED_HOSTS=meu-notebook.tail1234.ts.net
# Avisos no celular pelo app grátis ntfy: um nome de canal comprido e secreto (12 a 64 letras)
# ALFRED_NTFY=alfred-xxxx-xxxx-xxxx-xxxx
# ALFRED_NTFY_URL=https://ntfy.sh
# DDD dos números ditos sem DDD ("o número do João é 99912-3456")
# ALFRED_DDD=69
# Números de telefone para ligar e mandar WhatsApp (contatos.json ao lado do Alfred). off = desligado.
# ALFRED_CONTATOS=

# Voz do Fabio (ElevenLabs) em todas as respostas. Precisa de plano pago no ElevenLabs (as vozes
# da biblioteca não saem pela API no plano grátis). Crie a chave em elevenlabs.io → API Keys.
ELEVENLABS_API_KEY=
# ALFRED_ELEVENLABS_VOICE=Dps47AVoFamqqkDShRDS   # Fabio Oliveira Deep Portuguese
# ALFRED_ELEVENLABS_MODEL=eleven_v4_turbo        # troca sozinho para eleven_flash_v2_5 se a conta recusar

# Voz de IA (natural, sem som robótico). Outra opção: a sua chave da OpenAI.
# Com ela o Alfred usa o gpt-4o-mini-tts direto na OpenAI (pago por uso, centavos por conversa).
OPENAI_API_KEY=
# Voz da OpenAI: onyx (grave), ash, echo, cedar, ballad, fable, sage, verse...
ALFRED_TTS_VOICE=onyx
# Alternativa: voz pelo OmniRoute (/v1/audio/speech) com um provedor de voz conectado nele.
# ALFRED_TTS_PROVIDER=omniroute
# ALFRED_TTS_MODEL=openai/gpt-4o-mini-tts
# ALFRED_TTS_SPEED=1   # tts-1 / tts-1-hd (0,25 a 4) e ElevenLabs (0,7 a 1,2)
# ALFRED_TTS_INSTRUCTIONS="Personagem: um mordomo experiente... (estilo da voz no gpt-4o-mini-tts)"

# Lembretes, despertador, timer e listas (lembretes.json ao lado do Alfred, só neste PC).
# off = desligado.
# ALFRED_LEMBRETES=

# Personalização
ALFRED_USER_NAME=
# ALFRED_SYSTEM_PROMPT="Você é Alfred, ..."
